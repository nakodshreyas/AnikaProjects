# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this using your deployment platform's secrets manager.
GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted.
# Configure this in your deployment environment.
APP_URL="http://localhost:3000"

# CLIENT DASHBOARD AUTHENTICATION
# Use a dedicated authentication provider or securely managed credentials.
# Never commit real client credentials.
VITE_CLIENT_EMAIL="your-client-email@example.com"
VITE_CLIENT_PASSWORD=""

# SUPABASE CONFIGURATION
# Optional: Connect to your Supabase project for persistent cloud DB and Storage.
# Use the appropriate public URL and anon/publishable key for client-side access.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Client-side Supabase configuration.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY=""
